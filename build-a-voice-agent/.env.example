# Vapi uses this only when we add the assistant-provisioning and call scripts.
VAPI_API_KEY=
# Required for every Vapi- and operator-facing API route. Replace locally.
API_BEARER_TOKEN=local-demo-token
OPENAI_API_KEY=
# Use a deterministic OpenTelemetry GenAI span instead of an OpenAI request.
MOCK_AI_METADATA=0
# Loads @inngest/otel before the app so AI Metadata appears in the dashboard.
ENABLE_AI_METADATA=1
# Artificial per-system latency for the local webinar demo (milliseconds).
DEMO_SYSTEM_LATENCY_MS=1200

# Inngest Cloud needs these two values. Create them in your Inngest environment.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Local development: leave the two Cloud keys blank and use the Dev Server.
INNGEST_DEV=1
# Enables the unauthenticated /test shortcut locally. The server rejects it in production.
DEMO_MODE=1
# Optional: use an explicit SQLite path (set this to a mounted Railway Volume in production).
# DATABASE_PATH=/app/data/voice-agent.db
PORT=3000
